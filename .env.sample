# =============================================================================
# OpenCTI Docker Deployment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker compose.
#
# Quick start (Linux):
#   cp .env.sample .env
#   # Then edit .env with your values, or use the defaults below for local dev
#
# Required host setting (Linux only):
#   sudo sysctl -w vm.max_map_count=1048575
# =============================================================================

# --- Dependencies -----------------------------------------------------------

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=changeme-minio
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=changeme-rabbitmq
ELASTIC_MEMORY_SIZE=4G

# --- OpenCTI Platform -------------------------------------------------------

OPENCTI_PORT=8080
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@opencti.io
OPENCTI_ADMIN_PASSWORD=ChangeMePlease
OPENCTI_ADMIN_TOKEN=b1976749-8a53-4c49-a8c2-47d7d52e3f9a
OPENCTI_HEALTHCHECK_ACCESS_KEY=healthcheck-key
OPENCTI_ENCRYPTION_KEY=dGhpcklzQVRlc3RLZXlGb3JEZXZPbmx5MTIzNDU2Nzg=

# --- AI (Anthropic Claude) --------------------------------------------------

AI_ENABLED=true
AI_TYPE=anthropic
AI_TOKEN=sk-ant-your-anthropic-api-key-here
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=4096

# --- Connectors (optional API keys) -----------------------------------------

# AlienVault OTX - free at https://otx.alienvault.com (sign up, go to Settings > API)
ALIENVAULT_API_KEY=

# NVD API Key - free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Optional ---------------------------------------------------------------

SMTP_HOSTNAME=localhost
