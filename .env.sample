# =============================================================================
# Argus Docker Deployment Configuration
# =============================================================================
# Copy this file to .env and REPLACE every CHANGE_ME value before deploying.
# The platform refuses to start if the admin token/password or encryption key
# are left as the example values.
#
# Generate strong secrets:
#   OPENCTI_ENCRYPTION_KEY        -> openssl rand -base64 32
#   OPENCTI_ADMIN_TOKEN           -> uuidgen
#   OPENCTI_ADMIN_PASSWORD        -> openssl rand -base64 24
#   OPENCTI_HEALTHCHECK_ACCESS_KEY-> openssl rand -hex 16
#   MINIO_ROOT_PASSWORD / RABBITMQ_DEFAULT_PASS -> openssl rand -base64 24
#
# Quick start (Linux):
#   cp .env.sample .env && nano .env   # replace all CHANGE_ME values
#   sudo sysctl -w vm.max_map_count=1048575
#   docker compose up --build -d
# =============================================================================

# --- Dependencies -----------------------------------------------------------

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_password
ELASTIC_MEMORY_SIZE=4G

# --- Argus Platform ---------------------------------------------------------

OPENCTI_PORT=8080
OPENCTI_BASE_URL=http://localhost:8080
OPENCTI_ADMIN_EMAIL=admin@opencti.io
# REQUIRED - replace all of the following. Do not reuse these examples.
OPENCTI_ADMIN_PASSWORD=CHANGE_ME_admin_password
OPENCTI_ADMIN_TOKEN=CHANGE_ME_run_uuidgen
OPENCTI_HEALTHCHECK_ACCESS_KEY=CHANGE_ME_run_openssl_rand_hex_16
OPENCTI_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Optional - Enterprise Edition. Leave empty for Community Edition.
# To legitimately enable EE features, request a license from Filigran
# (https://filigran.io/opencti-enterprise-edition-free-license-request/) and
# paste the PEM certificate here.
OPENCTI_ENTERPRISE_LICENSE=

# --- AI (Anthropic Claude) --------------------------------------------------

AI_ENABLED=true
AI_TYPE=anthropic
AI_TOKEN=sk-ant-your-anthropic-api-key-here
AI_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=4096

# --- Connectors (optional API keys) -----------------------------------------

# AlienVault OTX - free at https://otx.alienvault.com (sign up, go to Settings > API)
ALIENVAULT_API_KEY=

# NVD API Key - free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Optional ---------------------------------------------------------------

SMTP_HOSTNAME=localhost
